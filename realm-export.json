{
  "id": "zantrix",
  "realm": "zantrix",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "PHYSICIAN", "description": "Physician" },
      { "name": "NURSE", "description": "Nurse" },
      { "name": "PHARMACIST", "description": "Pharmacist" },
      { "name": "ADMIN", "description": "System administrator" },
      { "name": "PRIVACY_OFFICER", "description": "Privacy officer" },
      { "name": "PATIENT", "description": "Patient" }
    ]
  },
  "clientScopes": [
    {
      "name": "web-origins",
      "description": "Adds the client's allowed web origins to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Minimal OpenID Connect profile claims used by Zantrix",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email claim used by Zantrix",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Adds realm roles to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "user/*.cruds",
      "description": "SMART user scope for staff access to all supported resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "zantrix-frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email",
        "user/*.cruds"
      ],
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5173"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "physician_test",
      "enabled": true,
      "email": "physician@zantrix.local",
      "firstName": "Test",
      "lastName": "Physician",
      "credentials": [
        { "type": "password", "value": "test", "temporary": false }
      ],
      "realmRoles": [ "PHYSICIAN" ]
    },
    {
      "username": "nurse_test",
      "enabled": true,
      "email": "nurse@zantrix.local",
      "firstName": "Test",
      "lastName": "Nurse",
      "credentials": [
        { "type": "password", "value": "test", "temporary": false }
      ],
      "realmRoles": [ "NURSE" ]
    },
    {
      "username": "admin_test",
      "enabled": true,
      "email": "admin@zantrix.local",
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "test", "temporary": false }
      ],
      "realmRoles": [ "ADMIN" ]
    },
    {
      "username": "privacy_test",
      "enabled": true,
      "email": "privacy@zantrix.local",
      "firstName": "Test",
      "lastName": "Privacy Officer",
      "credentials": [
        { "type": "password", "value": "test", "temporary": false }
      ],
      "realmRoles": [ "PRIVACY_OFFICER" ]
    }
  ]
}
