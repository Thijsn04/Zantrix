# Zantrix frontend configuration. Copy to .env.local for local overrides.

# Base URL of the Zantrix backend API.
VITE_API_BASE_URL=http://localhost:8080

# OpenID Connect (Keycloak) settings.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/zantrix
VITE_OIDC_CLIENT_ID=zantrix-frontend
# Defaults to the current origin when unset.
VITE_OIDC_REDIRECT_URI=http://localhost:5173
