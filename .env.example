# Optional Docker Compose overrides for local development.

# Keep the issuer equal to the URL embedded in Keycloak tokens. The JWK URL is
# resolved by the backend container and may use the private Compose hostname.
ZANTRIX_OIDC_ISSUER_URI=http://localhost:8081/realms/zantrix
ZANTRIX_OIDC_JWK_SET_URI=http://keycloak:8080/realms/zantrix/protocol/openid-connect/certs

ZANTRIX_CORS_ALLOWED_ORIGINS=http://localhost:5173
ZANTRIX_CONSENT_MODE=deny-on-explicit
ZANTRIX_RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Tune these for the Docker host. Snowstorm and Elasticsearch need enough heap
# for the licensed SNOMED CT edition loaded by the operator.
ZANTRIX_ES_JAVA_OPTS=-Xms2g -Xmx2g
ZANTRIX_SNOWSTORM_MAX_HEAP=3g

VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/zantrix
VITE_OIDC_CLIENT_ID=zantrix-frontend
